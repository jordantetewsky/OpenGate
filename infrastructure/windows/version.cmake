# Shared by normal and diagnostic Windows resources.
if(NOT DEFINED UNBOUND_VERSION)
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../../VERSION" UNBOUND_VERSION LIMIT_COUNT 1)
endif()
if(NOT UNBOUND_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    message(FATAL_ERROR "UNBOUND_VERSION must begin with MAJOR.MINOR.PATCH")
endif()
set(UNBOUND_MAJOR "${CMAKE_MATCH_1}")
set(UNBOUND_MINOR "${CMAKE_MATCH_2}")
set(UNBOUND_PATCH "${CMAKE_MATCH_3}")
if(NOT DEFINED UNBOUND_BUILD)
    set(UNBOUND_BUILD 0)
endif()
foreach(part UNBOUND_MAJOR UNBOUND_MINOR UNBOUND_PATCH UNBOUND_BUILD)
    if(NOT "${${part}}" MATCHES "^[0-9]+$" OR ${part} GREATER 65535)
        message(FATAL_ERROR "${part} must fit the Windows resource range 0..65535")
    endif()
endforeach()
if(NOT DEFINED UNBOUND_BUILD_ID)
    string(TIMESTAMP UNBOUND_BUILD_ID "%Y%m%dT%H%M%SZ" UTC)
endif()
